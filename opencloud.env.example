# copy to opencloud.env and adjust

## Basic Settings (must change) ##
OC_URL=https://cloud.opencloud.test

# admin password
#IDM_ADMIN_PASSWORD=changeme

# Additional services to be started on opencloud startup
# The following list of services is not started automatically and must be
# manually defined for startup:
# IMPORTANT: Add any services to the startup list comma separated like "notifications,antivirus" etc.
#OC_ADD_RUN_SERVICES=

# Default language for services/WebUI; defaults to English,
# language code (ISO 639-1, e.g. de, en, fr)
#OC_DEFAULT_LANGUAGE=en

## Email server ##
# Also add "notifications" to OC_ADD_RUN_SERVICES to actually send mails.
#NOTIFICATIONS_SMTP_HOST=
#NOTIFICATIONS_SMTP_PORT=
#NOTIFICATIONS_SMTP_SENDER=OpenCloud Notifications <notifications@cloud.opencloud.test>
#NOTIFICATIONS_SMTP_USERNAME=
#NOTIFICATIONS_SMTP_PASSWORD=
#NOTIFICATIONS_SMTP_INSECURE=false
#NOTIFICATIONS_SMTP_AUTHENTICATION=
# starttls, ssltls or none
#NOTIFICATIONS_SMTP_ENCRYPTION=none

## euro-office (uncomment when enabled) ##
# Also add "collaboration" to OC_ADD_RUN_SERVICES
#EURO_OFFICE_DOMAIN=euro-office.opencloud.test
#COLLABORATION_WOPI_SRC=https://cloud.opencloud.test
#COLLABORATION_APP_ADDR=https://euro-office.opencloud.test
#COLLABORATION_APP_ICON=https://euro-office.opencloud.test/web-apps/apps/documenteditor/main/resources/img/favicon.ico
#JWT_SECRET=

## yjs (uncomment when enabled) ##
#WEB_OPTION_YJS_SERVER_URL=wss://cloud.opencloud.test/yjs
